# ActionFlow — environment variables
# Copy to .env and fill in. Never commit .env.
# "web" = apps/web (Vercel) · "pipeline" = services/pipeline (Railway)
# Variables marked (Phase N) are not needed until that roadmap phase.

# ── Supabase ────────────────────────────────────────────────────────────────
# Project URL, e.g. https://abcd1234.supabase.co  (web + pipeline)
NEXT_PUBLIC_SUPABASE_URL=
# Anon (publishable) key — safe for the browser, RLS enforces access  (web)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — BYPASSES RLS. Pipeline only. Never expose to the frontend.  (pipeline)
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string (Supabase → Settings → Database).
# Used by the pipeline for the job queue (SELECT ... FOR UPDATE SKIP LOCKED).  (pipeline)
DATABASE_URL=postgresql://postgres:password@localhost:54322/postgres
# JWT issuer/audience for verifying Supabase user tokens on the pipeline.  (pipeline)
# Issuer is <SUPABASE_URL>/auth/v1 ; audience is "authenticated".
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated

# ── Service wiring ──────────────────────────────────────────────────────────
# Where the web app's proxy routes reach the pipeline. Local default below.  (web)
PIPELINE_URL=http://localhost:8000
# Public URL of the web app (OAuth redirects, links in emails).  (pipeline)
APP_BASE_URL=http://localhost:3000
# local | preview | production — switches logging & guard rails.  (both)
APP_ENV=local

# ── LLM providers (pipeline) ────────────────────────────────────────────────
# At least one is required for extraction (Phase 1). Costs money per token —
# see README §Costs. Model names are configured here, not hardcoded, so we can
# switch to cheaper/open models later without a code change.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
# Primary + fallback model ids used by the extraction chain (ARCH §6 row 3).
LLM_PRIMARY_MODEL=
LLM_FALLBACK_MODEL=
# Hard monthly token budget per org before we build real metering (safety net).
LLM_ORG_MONTHLY_TOKEN_CAP=2000000

# ── Speech-to-text (pipeline, Phase 1 — pick ONE to start, see PRD OQ-6) ────
# Free credits on both are limited and run out. ⚠
ASSEMBLYAI_API_KEY=
DEEPGRAM_API_KEY=
# Set to "assemblyai" | "deepgram" | "whisper_local"
STT_PROVIDER=assemblyai

# ── Security (pipeline) ─────────────────────────────────────────────────────
# Fernet key for encrypting integration OAuth tokens at rest (ARCH §5).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ── Email (pipeline, Phase 3) ───────────────────────────────────────────────
# Resend free tier caps monthly sends. ⚠
RESEND_API_KEY=
FOLLOWUP_FROM_EMAIL=followups@yourdomain.example

# ── Stripe (pipeline, Phase 4) ──────────────────────────────────────────────
# Per-transaction fees apply on every payment. ⚠
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs created in the Stripe dashboard.
STRIPE_PRICE_PRO_SEAT=
STRIPE_PRICE_TEAM_SEAT=

# ── Meeting platform OAuth apps (pipeline, Phase 5) ─────────────────────────
# Zoom transcripts require the HOST's paid Zoom plan (cloud recording). ⚠
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Microsoft Teams (deferred — see ROADMAP "Explicitly deferred")
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=

# ── Task tool integrations (pipeline, Phase 2+; fill only what you connect) ─
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
ASANA_CLIENT_ID=
ASANA_CLIENT_SECRET=
TODOIST_CLIENT_ID=
TODOIST_CLIENT_SECRET=

# ── Observability (both, optional but recommended from Phase 0) ─────────────
# Sentry free tier caps events/month. ⚠
SENTRY_DSN_WEB=
SENTRY_DSN_PIPELINE=
LOG_LEVEL=INFO
